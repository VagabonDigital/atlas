        "plan": [
          "Why does that go on the sled and not the pack?",
          "What would you drop first?"
        ],
        "commit": [
          "What are you refusing to leave behind?"
        ],
        "perturb": [
          "How much of that plan still works?"
        ],
        "react": [
          "What has to come out now?"
        ],
        "revise": [
          "Warmth, safety or footage. Which one goes?"
        ],
        "resolve": [
          "Was the sled a mistake, or just bad luck?"
        ]
      },
